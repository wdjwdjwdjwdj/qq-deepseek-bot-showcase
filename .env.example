# 环境变量示例 —— 只列键名，所有值留空，切勿填入真实密钥后提交
# LLM provider 的 API key 实际存放在 model_config.toml（已 gitignore），此处仅为占位说明
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
SENSENOVA_API_KEY=
OPENROUTER_API_KEY=

# 飞鱼 TTS（可选的自托管语音服务）
FEIYU_TTS_URL=
FEIYU_TTS_KEY=
FEIYU_TTS_STYLE=

# TTS 微调（可选）
MAIBOT_TTS_RATE=
MAIBOT_TTS_PITCH=

# NapCat / OneBot 本地服务（默认本机地址，无需密钥示例）
NAPCAT_HTTP_URL=
